{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM is needed because Playwright's `page.evaluate` callbacks are browser
    // code that happens to be authored inside a Node test file.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tooling.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "test/**/*.ts"
  ]
}
