{
  "name": "azir",
  "version": "0.0.4",
  "private": true,
  "description": "Desktop supervision tool for software agents",
  "license": "MIT",
  "author": "Claudio Guevara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClaudioGuevaraDev/azir.git"
  },
  "main": "./out/main/index.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:preload && pnpm run typecheck:renderer && pnpm run typecheck:tooling",
    "typecheck:main": "tsc --noEmit --composite false -p tsconfig.main.json",
    "typecheck:preload": "tsc --noEmit --composite false -p tsconfig.preload.json",
    "typecheck:renderer": "tsc --noEmit --composite false -p tsconfig.renderer.json",
    "typecheck:tooling": "tsc --noEmit --composite false -p tsconfig.tooling.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:dir": "pnpm run build && electron-builder --dir --publish never",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "node-pty": false,
    "esbuild": false,
    "electron-winstaller": false
  }
}
